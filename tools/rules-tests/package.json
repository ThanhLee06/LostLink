{
  "name": "lostlink-rules-tests",
  "version": "1.0.0",
  "description": "Firestore Security Rules unit tests for LostLink",
  "scripts": {
    "test": "jest --runInBand --testTimeout=30000",
    "test:watch": "jest --runInBand --watch --testTimeout=30000",
    "test:emulators": "firebase emulators:exec --only auth,firestore --project demo-lostlink --config ../../firebase.emulators.json \"npm test\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.0.0",
    "firebase-tools": "^15.36.0",
    "jest": "^29.7.0"
  }
}
