rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isVerifiedStudent() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && request.auth.token.email.matches('(?i)^.+@ut[.]edu[.]vn$');
    }

    match /posts/{postId} {
      allow read: if isVerifiedStudent();
      allow create: if isVerifiedStudent()
        && request.resource.data.authorId == request.auth.uid;
      allow update: if isVerifiedStudent()
        && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == resource.data.authorId;
      allow delete: if isVerifiedStudent() && resource.data.authorId == request.auth.uid;
    }

    match /users/{userId} {
      allow read, create, update, delete: if isVerifiedStudent() && request.auth.uid == userId;
    }

    // Add narrowly scoped matches for new collections. Everything else is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
