# LostLink Backend — Environment Variables
# Copy this to .env and fill in your real values. NEVER commit .env to source control.

APP_ENV=development
LOG_LEVEL=INFO

FIREBASE_PROJECT_ID=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=path/to/serviceAccountKey.json

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_SIGNATURE_ALGORITHM=sha1
CLOUDINARY_UPLOAD_PRESET=

GEMINI_API_KEY=your_gemini_api_key
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_MODEL_REVISION=2026-01
EMBEDDING_DIMENSIONS=768
EMBEDDING_INDEX_VERSION=1

# Firebase Emulator Suite
USE_FIREBASE_EMULATOR=false
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIRESTORE_EMULATOR_HOST=localhost:8088

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# Backend internal API key (MUST be replaced with a random secret in non-test envs)
BACKEND_API_KEY=change_me_random_string

# Rate limiting & worker tuning
WAKE_RATE_LIMIT_MAX=10
WAKE_RATE_LIMIT_WINDOW_SECONDS=60
WORKER_BATCH_LIMIT=10
WORKER_LEASE_SECONDS=60
WORKER_POLL_MIN_SECONDS=5
WORKER_POLL_MAX_SECONDS=60
MEDIA_ABANDONED_TTL_SECONDS=86400
MEDIA_SIGNED_UPLOAD_WINDOW_SECONDS=3600
RUN_BOOT_RECOVERY=true
